{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/bills/(.*)",
      "destination": "/api"
    },
    {
      "source": "/bill/(.*)",
      "destination": "/api"
    },
    {
      "source": "/verify-bill/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
