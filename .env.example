# ==========================================
# LogiBill ERP - Environment Variables
# ==========================================

# Production Database (PostgreSQL / Neon / Supabase / Vercel Postgres)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Node Environment & Port (Local: 5000)
NODE_ENV=production
PORT=5000

# Authentication JWT Secret
JWT_SECRET=your-secure-random-jwt-secret-here

# Optional: AI Assistant / External LLM API Key (Falls back to built-in logistics AI assistant if omitted)
AI_API_KEY=

# Optional: Authorized GST GSP API Credentials (Runs in intelligent mock sandbox if omitted)
GST_API_BASE_URL=https://api.mastergst.com
GST_API_KEY=
GST_API_SECRET=

# Optional: Meta WhatsApp Cloud API Credentials (Runs in intelligent mock sandbox if omitted)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=logibill_webhook_token_2026
